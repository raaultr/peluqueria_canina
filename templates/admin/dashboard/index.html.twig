{% extends 'base.html.twig' %}

{% block title %}Inicio | PeluCan{% endblock %}

{% block body %}
    {% include 'admin/components/_navbar.html.twig' %}

    <div class="min-h-screen pt-36 md:pl-64 md:pt-0">
        <header class="flex h-16 items-center justify-end border-b border-(--color-border) bg-(--color-surface) px-5 md:px-8">
            <div class="flex items-center gap-3">
                <span class="hidden text-right sm:block">
                    <span class="block text-sm font-semibold text-(--color-text-primary)">Administrador</span>
                    <span class="block text-xs text-(--color-text-secondary)">Panel de gestión</span>
                </span>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-(--color-brand-soft) text-sm font-bold text-(--color-brand)" aria-hidden="true">A</span>
            </div>
        </header>

        <main class="mx-auto max-w-7xl px-5 py-8 md:px-8 md:py-10">
            <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
                <div>
                    <p class="mb-2 text-sm font-medium text-(--color-brand)">{{ 'now'|date('d/m/Y') }}</p>
                    <h1 class="text-3xl font-bold tracking-tight text-(--color-text-primary)">Inicio</h1>
                    <p class="mt-2 text-sm text-(--color-text-secondary)">Bienvenido a la gestión de PeluCan.</p>
                </div>
            </div>

            <section aria-labelledby="accesos-title">
                <h2 id="accesos-title" class="mb-4 text-lg font-semibold text-(--color-text-primary)">Accesos principales</h2>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <a href="#" class="group rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-5 shadow-(--shadow-panel) transition hover:border-(--focus-ring) hover:shadow-md">
                        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-(--radius-control) bg-(--color-brand-soft) text-(--color-brand)">
                            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 20a7 7 0 0 1 14 0"/></svg>
                        </span>
                        <span class="block font-semibold text-(--color-text-primary) group-hover:text-(--color-brand-hover)">Clientes</span>
                        <span class="mt-1 block text-sm text-(--color-text-secondary)">Consulta la información de tus clientes.</span>
                    </a>
                    <a href="#" class="group rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-5 shadow-(--shadow-panel) transition hover:border-(--focus-ring) hover:shadow-md">
                        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-(--radius-control) bg-(--color-success-soft) text-(--color-success)">
                            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 13c-2.8-2.6-6.5-1-6.5 2.4 0 2.4 2 4.6 4.2 4.6 1 0 1.7-.5 2.3-1.2.6.7 1.3 1.2 2.3 1.2 2.2 0 4.2-2.2 4.2-4.6 0-3.4-3.7-5-6.5-2.4Z"/><circle cx="6" cy="7" r="1.5"/><circle cx="10" cy="5" r="1.5"/><circle cx="15" cy="5" r="1.5"/><circle cx="19" cy="8" r="1.5"/></svg>
                        </span>
                        <span class="block font-semibold text-(--color-text-primary) group-hover:text-(--color-brand-hover)">Mascotas</span>
                        <span class="mt-1 block text-sm text-(--color-text-secondary)">Accede a las fichas de las mascotas.</span>
                    </a>
                    <a href="#" class="group rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-5 shadow-(--shadow-panel) transition hover:border-(--focus-ring) hover:shadow-md sm:col-span-2 lg:col-span-1">
                        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-(--radius-control) bg-(--color-danger-soft) text-(--color-danger)">
                            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="16" rx="2"/><path stroke-linecap="round" d="M8 3v4m8-4v4M4 10h16"/></svg>
                        </span>
                        <span class="block font-semibold text-(--color-text-primary) group-hover:text-(--color-brand-hover)">Citas</span>
                        <span class="mt-1 block text-sm text-(--color-text-secondary)">Organiza la agenda de la peluquería.</span>
                    </a>
                </div>
            </section>
    </main>
    </div>
{% endblock %}