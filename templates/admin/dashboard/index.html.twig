{% extends 'base.html.twig' %}

{% block title %}Inicio | PeluCan{% endblock %}

{% block body %}
    {% include 'admin/components/_navbar.html.twig' %}

    <div class="min-h-screen pt-36 md:pl-64 md:pt-0">
        <header class="flex h-16 items-center justify-end border-b border-slate-200 bg-white px-5 md:px-8">
            <div class="flex items-center gap-3">
                <span class="hidden text-right sm:block">
                    <span class="block text-sm font-semibold text-slate-800">Administrador</span>
                    <span class="block text-xs text-slate-500">Panel de gestión</span>
                </span>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700" aria-hidden="true">A</span>
            </div>
        </header>

        <main class="mx-auto max-w-7xl px-5 py-8 md:px-8 md:py-10">
            <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
                <div>
                    <p class="mb-2 text-sm font-medium text-blue-600">{{ 'now'|date('d/m/Y') }}</p>
                    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Inicio</h1>
                    <p class="mt-2 text-sm text-slate-500">Bienvenido a la gestión de PeluCan.</p>
                </div>
            </div>

            <section aria-labelledby="accesos-title">
                <h2 id="accesos-title" class="mb-4 text-lg font-semibold text-slate-800">Accesos principales</h2>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <a href="#" class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md">
                        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 20a7 7 0 0 1 14 0"/></svg>
                        </span>
                        <span class="block font-semibold text-slate-800 group-hover:text-blue-700">Clientes</span>
                        <span class="mt-1 block text-sm text-slate-500">Consulta la información de tus clientes.</span>
                    </a>
                    <a href="#" class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md">
                        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 13c-2.8-2.6-6.5-1-6.5 2.4 0 2.4 2 4.6 4.2 4.6 1 0 1.7-.5 2.3-1.2.6.7 1.3 1.2 2.3 1.2 2.2 0 4.2-2.2 4.2-4.6 0-3.4-3.7-5-6.5-2.4Z"/><circle cx="6" cy="7" r="1.5"/><circle cx="10" cy="5" r="1.5"/><circle cx="15" cy="5" r="1.5"/><circle cx="19" cy="8" r="1.5"/></svg>
                        </span>
                        <span class="block font-semibold text-slate-800 group-hover:text-blue-700">Mascotas</span>
                        <span class="mt-1 block text-sm text-slate-500">Accede a las fichas de las mascotas.</span>
                    </a>
                    <a href="#" class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md sm:col-span-2 lg:col-span-1">
                        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-rose-50 text-rose-600">
                            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="16" rx="2"/><path stroke-linecap="round" d="M8 3v4m8-4v4M4 10h16"/></svg>
                        </span>
                        <span class="block font-semibold text-slate-800 group-hover:text-blue-700">Citas</span>
                        <span class="mt-1 block text-sm text-slate-500">Organiza la agenda de la peluquería.</span>
                    </a>
                </div>
            </section>
        </main>
    </main>
{% endblock %}