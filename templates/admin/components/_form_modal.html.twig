<div class="fixed inset-0 z-[100] flex items-end justify-center bg-slate-950/45 p-0 backdrop-blur-sm sm:items-center sm:p-5" data-admin-modal data-close-url="{{ modalCloseUrl }}">
    <button type="button" class="absolute inset-0 cursor-default" data-modal-backdrop aria-label="Cerrar ventana"></button>
    <section role="dialog" aria-modal="true" aria-labelledby="admin-modal-title" tabindex="-1" data-admin-modal-content class="relative z-10 max-h-[94svh] w-full overflow-y-auto rounded-t-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-5 shadow-2xl sm:max-w-2xl sm:rounded-(--radius-panel) sm:p-7">
        <header class="mb-6 flex items-start justify-between gap-4">
            <div>
                <h2 id="admin-modal-title" class="text-xl font-bold text-(--color-text-primary) sm:text-2xl">{{ modalTitle }}</h2>
                <p class="mt-1 text-sm text-(--color-text-secondary)">{{ modalDescription }}</p>
            </div>
            <a href="{{ modalCloseUrl }}" aria-label="Cerrar ventana" title="Cerrar" class="grid h-9 w-9 shrink-0 place-items-center rounded-(--radius-control) text-(--color-text-secondary) transition hover:bg-(--color-surface-muted) hover:text-(--color-text-primary)">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </a>
        </header>

        {{ include(modalFormTemplate) }}
    </section>
</div>