<div data-controller="mobile-menu" data-action="keydown.esc@window->mobile-menu#closeOnEscape">
	<button type="button" class="fixed left-4 top-3 z-60 grid h-10 w-10 place-items-center rounded-(--radius-control) bg-(--color-surface) text-(--color-text-primary) shadow-(--shadow-panel) md:hidden" aria-label="Abrir menú" aria-controls="admin-menu" aria-expanded="false" data-mobile-menu-target="toggle" data-action="click->mobile-menu#toggle">
		<svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
	</button>
	<button type="button" class="fixed inset-0 z-40 hidden bg-slate-950/45 md:hidden" aria-label="Cerrar menú" data-mobile-menu-target="backdrop" data-action="click->mobile-menu#close"></button>

	<aside id="admin-menu" data-mobile-menu-target="menu" class="invisible fixed inset-y-0 left-0 z-50 flex h-screen w-72 max-w-[85vw] -translate-x-full transform flex-col overflow-y-auto border-r border-(--color-border) bg-(--color-surface) px-4 py-5 shadow-xl transition-transform duration-200 md:visible md:translate-x-0 md:z-20 md:w-64 md:max-w-none md:shadow-none">
		<div class="flex items-center justify-between gap-3 md:justify-start">
			<a href="{{ path('admin_dashboard') }}" class="flex min-w-0 items-center gap-3 md:px-2">
				<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-(--radius-panel) bg-(--color-brand) text-white">
					<svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7" fill="currentColor">
						<circle cx="8" cy="10" r="3.2"/><circle cx="15" cy="6" r="3.2"/><circle cx="23" cy="8" r="3.2"/><circle cx="27" cy="15" r="2.8"/><path d="M16 12c-5.2 0-10 6.2-10 10.8a4.2 4.2 0 0 0 4.3 4.2c2 0 3.6-1 5.7-1s3.7 1 5.7 1a4.2 4.2 0 0 0 4.3-4.2C26 18.2 21.2 12 16 12Z"/>
					</svg>
				</span>
				<span class="min-w-0">
					<span class="block text-base font-bold leading-tight text-(--color-text-primary)">PeluCan</span>
					<span class="block text-xs text-(--color-text-secondary)">Peluquería Canina</span>
				</span>
			</a>
			<button type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-(--radius-control) text-(--color-text-primary) hover:bg-(--color-surface-muted) md:hidden" aria-label="Cerrar menú" data-mobile-menu-target="closeButton" data-action="click->mobile-menu#close">
				<svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/></svg>
			</button>
		</div>

		{% set display_name = (app.user.nombre ~ ' ' ~ app.user.apellido)|trim %}
		<div class="mt-6 flex min-h-0 flex-1 flex-col">
			<div class="mb-4 flex items-center gap-3 border-b border-(--color-border) px-2 pb-4 md:hidden">
				<span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-(--color-brand-soft) text-lg font-bold text-(--color-brand)" role="img" aria-label="Avatar de {{ display_name }}">{{ display_name|slice(0, 1)|upper }}</span>
				<div class="min-w-0">
					<p class="truncate text-sm font-semibold text-(--color-text-primary)">{{ display_name }}</p>
					<p class="text-xs text-(--color-text-secondary)">
						{% if 'ROLE_ADMIN' in app.user.roles %}Administrador{% elseif 'ROLE_EMPLEADO' in app.user.roles %}Empleado{% else %}Cliente{% endif %}
					</p>
				</div>
			</div>

			<nav aria-label="Navegación principal" class="flex flex-col gap-1 md:flex-1">
				<a href="{{ path('admin_dashboard') }}" {% if app.request.attributes.get('_route') == 'admin_dashboard' %}aria-current="page"{% endif %} class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium transition {% if app.request.attributes.get('_route') == 'admin_dashboard' %}bg-(--color-brand) text-white shadow-(--shadow-panel){% else %}text-(--color-text-secondary) hover:bg-(--color-surface-muted) hover:text-(--color-text-primary){% endif %}">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m3 10 9-7 9 7M5 9v11h14V9M9 20v-7h6v7"/></svg><span>Inicio</span>
				</a>
				<a href="{{ path('app_cliente_index') }}" {% if app.request.attributes.get('_route') starts with 'app_cliente_' %}aria-current="page"{% endif %} class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium transition {% if app.request.attributes.get('_route') starts with 'app_cliente_' %}bg-(--color-brand) text-white shadow-(--shadow-panel){% else %}text-(--color-text-secondary) hover:bg-(--color-surface-muted) hover:text-(--color-text-primary){% endif %}">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 20a7 7 0 0 1 14 0M4 20h16"/></svg><span>Clientes</span>
				</a>
				<a href="{{ path('app_mascota_index') }}" {% if app.request.attributes.get('_route') starts with 'app_mascota_' %}aria-current="page"{% endif %} class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium transition {% if app.request.attributes.get('_route') starts with 'app_mascota_' %}bg-(--color-brand) text-white shadow-(--shadow-panel){% else %}text-(--color-text-secondary) hover:bg-(--color-surface-muted) hover:text-(--color-text-primary){% endif %}">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 13c-2.8-2.6-6.5-1-6.5 2.4 0 2.4 2 4.6 4.2 4.6 1 0 1.7-.5 2.3-1.2.6.7 1.3 1.2 2.3 1.2 2.2 0 4.2-2.2 4.2-4.6 0-3.4-3.7-5-6.5-2.4Z"/><circle cx="6" cy="7" r="1.5"/><circle cx="10" cy="5" r="1.5"/><circle cx="15" cy="5" r="1.5"/><circle cx="19" cy="8" r="1.5"/></svg><span>Mascotas</span>
				</a>
				<a href="{{ path('app_cita_index') }}" {% if app.request.attributes.get('_route') starts with 'app_cita_' %}aria-current="page"{% endif %} class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium transition {% if app.request.attributes.get('_route') starts with 'app_cita_' %}bg-(--color-brand) text-white shadow-(--shadow-panel){% else %}text-(--color-text-secondary) hover:bg-(--color-surface-muted) hover:text-(--color-text-primary){% endif %}">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="16" rx="2"/><path stroke-linecap="round" d="M8 3v4m8-4v4M4 10h16"/></svg><span>Citas</span>
				</a>
				<a href="{{ path('app_servicio_index') }}" {% if app.request.attributes.get('_route') starts with 'app_servicio_' %}aria-current="page"{% endif %} class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium transition {% if app.request.attributes.get('_route') starts with 'app_servicio_' %}bg-(--color-brand) text-white shadow-(--shadow-panel){% else %}text-(--color-text-secondary) hover:bg-(--color-surface-muted) hover:text-(--color-text-primary){% endif %}">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m14 6 4-4 4 4-4 4m-8 8-4 4-4-4 4-4m1-7 10 10M5 19 19 5"/></svg><span>Servicios</span>
				</a>
				<a href="{{ path('app_empleado_index') }}" {% if app.request.attributes.get('_route') starts with 'app_empleado_' %}aria-current="page"{% endif %} class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium transition {% if app.request.attributes.get('_route') starts with 'app_empleado_' %}bg-(--color-brand) text-white shadow-(--shadow-panel){% else %}text-(--color-text-secondary) hover:bg-(--color-surface-muted) hover:text-(--color-text-primary){% endif %}">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.5 20a5.5 5.5 0 0 1 11 0m2-9a3 3 0 1 0-1-5.8M17 14a5 5 0 0 1 3.5 6"/></svg><span>Empleados</span>
				</a>
				<a href="#" class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium text-(--color-text-secondary) transition hover:bg-(--color-surface-muted) hover:text-(--color-text-primary)">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 7.8 7.5 4.4 7.5-4.4M12 12.2V21"/></svg><span>Productos</span>
				</a>
				<a href="#" class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium text-(--color-text-secondary) transition hover:bg-(--color-surface-muted) hover:text-(--color-text-primary)">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20h16M6 17V9h3v8m3 0V4h3v13m3 0v-6h3v6"/></svg><span>Reportes</span>
				</a>
			</nav>

			<div class="mt-auto flex flex-col gap-1 pt-4">
				<a href="#" class="flex items-center gap-3 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium text-(--color-text-secondary) transition hover:bg-(--color-surface-muted) hover:text-(--color-text-primary)">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3.5"/><path stroke-linecap="round" stroke-linejoin="round" d="m19.4 15 .1.1a1.8 1.8 0 1 1-2.5 2.5l-.1-.1a1.8 1.8 0 0 0-3 .9v.2a1.8 1.8 0 1 1-3.6 0v-.2a1.8 1.8 0 0 0-3-.9l-.1.1a1.8 1.8 0 1 1-2.5-2.5l.1-.1a1.8 1.8 0 0 0-.9-3h-.2a1.8 1.8 0 1 1 0-3.6h.2a1.8 1.8 0 0 0 .9-3l-.1-.1a1.8 1.8 0 1 1 2.5-2.5l.1.1a1.8 1.8 0 0 0 3-.9v-.2a1.8 1.8 0 1 1 3.6 0v.2a1.8 1.8 0 0 0 3 .9l.1-.1a1.8 1.8 0 1 1 2.5 2.5l-.1.1a1.8 1.8 0 0 0 .9 3h.2a1.8 1.8 0 1 1 0 3.6h-.2a1.8 1.8 0 0 0-.9 3Z"/></svg><span>Configuración</span>
				</a>
				<a href="{{ logout_path() }}" class="mt-3 flex items-center gap-3 rounded-(--radius-control) border-t border-rose-200 px-3 py-4 text-sm font-semibold text-rose-700 transition hover:bg-rose-50 hover:text-rose-800">
					<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5m5 5H3m9-9h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"/></svg><span>Cerrar sesión</span>
				</a>
			</div>
		</div>
	</aside>
</div>