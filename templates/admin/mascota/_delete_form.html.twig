<form method="post" action="{{ path('app_mascota_delete', {'id': mascotum.id}) }}" onsubmit="return confirm('¿Quieres eliminar esta mascota? Esta acción no se puede deshacer.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mascotum.id) }}">
    <button type="submit" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-danger) px-4 text-sm font-semibold text-(--color-danger) transition hover:bg-(--color-danger-soft)">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M4 7h16M10 11v6m4-6v6M5 7l1 14h12l1-14M9 7V4h6v3"/></svg>
        Eliminar
    </button>
</form>
