{% extends 'base.html.twig' %}

{% block title %}{{ mascotum.nombre }} | Mascotas | PeluCan{% endblock %}

{% block body %}
    {% include 'admin/components/_navbar.html.twig' %}

    <div class="min-h-screen md:pl-64">
        {% set display_name = (app.user.nombre ~ ' ' ~ app.user.apellido)|trim %}
        <header class="flex h-16 items-center justify-between border-b border-(--color-border) bg-(--color-surface) px-4 sm:px-5 md:px-8">
            <a href="{{ path('app_mascota_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-(--color-text-secondary) transition hover:text-(--color-brand)">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                Volver a mascotas
            </a>
            <span class="hidden text-sm font-semibold text-(--color-text-primary) sm:block">{{ display_name }}</span>
        </header>

        <main class="w-full px-4 py-6 sm:px-6 sm:py-8 md:px-8 md:py-9 2xl:px-12">
            <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div>
                    <p class="mb-1 text-sm font-medium text-(--color-brand)">Ficha de mascota</p>
                    <h1 class="text-2xl font-bold text-(--color-text-primary) sm:text-3xl">{{ mascotum.nombre }}</h1>
                    <p class="mt-1 text-sm text-(--color-text-secondary)">{{ mascotum.raza }} · {{ mascotum.tamano }}</p>
                </div>
                <div class="flex gap-2">
                    <a href="{{ path('app_mascota_edit', {id: mascotum.id}) }}" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-(--radius-control) bg-(--button-primary-background) px-4 text-sm font-semibold text-(--button-primary-text) transition hover:bg-(--button-primary-hover)">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="m14 5 5 5M4 20l4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z"/></svg>
                        Editar
                    </a>
                    {{ include('admin/mascota/_delete_form.html.twig', {mascotum: mascotum}) }}
                </div>
            </div>

            <div class="grid gap-5 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
                <section aria-labelledby="mascota-data-title" class="overflow-hidden rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-panel)">
                    <div class="flex items-center gap-4 border-b border-(--color-border) p-5 sm:p-6">
                        {% if mascotum.foto %}
                            <img src="{{ asset(mascotum.foto) }}" alt="Foto de {{ mascotum.nombre }}" class="h-20 w-20 shrink-0 rounded-2xl border border-(--color-border) object-cover">
                        {% else %}
                            <span class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl bg-(--color-brand-soft) text-(--color-brand)">
                                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-9 w-9" fill="currentColor"><path d="M12 13c-2.8-2.6-6.5-1-6.5 2.4 0 2.4 2 4.6 4.2 4.6 1 0 1.7-.5 2.3-1.2.6.7 1.3 1.2 2.3 1.2 2.2 0 4.2-2.2 4.2-4.6 0-3.4-3.7-5-6.5-2.4Z"/><circle cx="6" cy="7" r="1.5"/><circle cx="10" cy="5" r="1.5"/><circle cx="15" cy="5" r="1.5"/><circle cx="19" cy="8" r="1.5"/></svg>
                            </span>
                        {% endif %}
                        <div class="min-w-0">
                            <h2 id="mascota-data-title" class="text-lg font-semibold text-(--color-text-primary)">Información general</h2>
                            <p class="mt-1 truncate text-sm text-(--color-text-secondary)">{{ mascotum.cliente ? (mascotum.cliente.nombre ~ ' ' ~ mascotum.cliente.apellido)|trim : 'Sin cliente asignado' }}</p>
                        </div>
                    </div>
                    <dl class="grid gap-x-6 sm:grid-cols-2">
                        <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Raza</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ mascotum.raza }}</dd></div>
                        <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Sexo</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ mascotum.sexo ?: 'Sin indicar' }}</dd></div>
                        <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Fecha de nacimiento</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ mascotum.fechaNacimiento ? mascotum.fechaNacimiento|date('d/m/Y') : 'Sin registrar' }}</dd></div>
                        <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Peso</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ mascotum.peso is not null ? mascotum.peso|number_format(1, ',', '.') ~ ' kg' : 'Sin registrar' }}</dd></div>
                        <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Tamaño</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ mascotum.tamano }}</dd></div>
                        <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Registrada</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ mascotum.createdAt ? mascotum.createdAt|date('d/m/Y') : '—' }}</dd></div>
                        <div class="px-5 py-4 sm:col-span-2 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Notas</dt><dd class="mt-1 whitespace-pre-line text-sm leading-6 text-(--color-text-primary)">{{ mascotum.nota ?: 'No hay notas para esta mascota.' }}</dd></div>
                    </dl>
                </section>

                <section aria-labelledby="mascota-appointments-title" class="overflow-hidden rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-panel)">
                    <div class="flex items-center justify-between gap-3 border-b border-(--color-border) p-5 sm:p-6">
                        <div><h2 id="mascota-appointments-title" class="text-lg font-semibold text-(--color-text-primary)">Historial de citas</h2><p class="mt-1 text-sm text-(--color-text-secondary)">Visitas asociadas a {{ mascotum.nombre }}.</p></div>
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-(--radius-control) bg-(--color-brand-soft) text-(--color-brand)">
                            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
                        </span>
                    </div>
                    <div class="divide-y divide-(--color-border)">
                        {% for cita in citas %}
                            {% set estado = cita.estado|lower %}
                            <article class="p-5 transition hover:bg-(--color-surface-muted) sm:px-6">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <p class="font-semibold text-(--color-text-primary)">{{ cita.inicio ? cita.inicio|date('d/m/Y · H:i') : 'Fecha pendiente' }}</p>
                                    <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold {% if estado in ['confirmada', 'realizada'] %}bg-(--color-success-soft) text-(--color-success){% elseif estado == 'cancelada' %}bg-(--color-danger-soft) text-(--color-danger){% else %}bg-(--color-warning-soft) text-(--color-warning){% endif %}">{{ cita.estado }}</span>
                                </div>
                                <p class="mt-2 text-sm text-(--color-text-secondary)">
                                    {% if cita.citaServicios is not empty %}
                                        {% for citaServicio in cita.citaServicios %}{% if not loop.first %}, {% endif %}{{ citaServicio.servicio.nombre }}{% endfor %}
                                    {% else %}
                                        Sin servicios detallados
                                    {% endif %}
                                </p>
                                <p class="mt-1 text-xs text-(--color-text-muted)">Responsable: {{ cita.trabajador ? (cita.trabajador.nombre ~ ' ' ~ cita.trabajador.apellido)|trim : 'Sin asignar' }}{% if cita.fin %} · Fin {{ cita.fin|date('H:i') }}{% endif %}</p>
                            </article>
                        {% else %}
                            <div class="px-5 py-12 text-center sm:px-6">
                                <p class="font-medium text-(--color-text-primary)">Todavía no hay citas</p>
                                <p class="mt-1 text-sm text-(--color-text-secondary)">Cuando se programe una visita, aparecerá aquí.</p>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            </div>
        </main>
    </div>
{% endblock %}