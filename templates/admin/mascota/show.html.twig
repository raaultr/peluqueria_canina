{% extends 'base.html.twig' %}

{% block title %}Mascota{% endblock %}

{% block body %}
    <h1>Mascota</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ mascotum.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ mascotum.nombre }}</td>
            </tr>
            <tr>
                <th>Raza</th>
                <td>{{ mascotum.raza }}</td>
            </tr>
            <tr>
                <th>Sexo</th>
                <td>{{ mascotum.sexo }}</td>
            </tr>
            <tr>
                <th>FechaNacimiento</th>
                <td>{{ mascotum.fechaNacimiento ? mascotum.fechaNacimiento|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Peso</th>
                <td>{{ mascotum.peso }}</td>
            </tr>
            <tr>
                <th>Tamano</th>
                <td>{{ mascotum.tamano }}</td>
            </tr>
            <tr>
                <th>Foto</th>
                <td>{{ mascotum.foto }}</td>
            </tr>
            <tr>
                <th>Nota</th>
                <td>{{ mascotum.nota }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ mascotum.createdAt ? mascotum.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ mascotum.updatedAt ? mascotum.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_mascota_index') }}">back to list</a>

    <a href="{{ path('app_mascota_edit', {'id': mascotum.id}) }}">edit</a>

    {{ include('mascota/_delete_form.html.twig') }}
{% endblock %}
