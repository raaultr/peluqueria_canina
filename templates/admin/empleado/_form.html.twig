{{ form_start(form, {attr: {class: 'space-y-5'}}) }}
    <div class="grid gap-4 sm:grid-cols-2">
        {{ form_row(form.nombre, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}
        {{ form_row(form.apellido, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}
        <div class="space-y-1.5 sm:col-span-2">{{ form_row(form.email, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}</div>
        <div class="space-y-1.5 sm:col-span-2">{{ form_row(form.telefono, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}</div>
        <div class="space-y-1.5 sm:col-span-2">{{ form_row(form.direccion, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}</div>
        <div class="space-y-1.5">{{ form_row(form.plainPassword.first, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}</div>
        <div class="space-y-1.5">{{ form_row(form.plainPassword.second, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}</div>
    </div>
    <div class="flex flex-col-reverse gap-3 border-t border-(--color-border) pt-5 sm:flex-row sm:justify-end">
        <a href="{{ path('app_empleado_index', {estado: estadoFiltro}) }}" class="inline-flex min-h-10 items-center justify-center rounded-(--radius-control) border border-(--color-border) px-4 text-sm font-medium text-(--color-text-secondary) transition hover:bg-(--color-surface-muted)">Cancelar</a>
        <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-(--radius-control) bg-(--button-primary-background) px-5 text-sm font-semibold text-(--button-primary-text) transition hover:bg-(--button-primary-hover)">{{ modalSubmitLabel }}</button>
    </div>
{{ form_end(form) }}