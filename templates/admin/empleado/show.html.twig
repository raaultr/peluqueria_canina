{% extends 'base.html.twig' %}

{% block title %}{{ empleado.nombre }} {{ empleado.apellido }} | Empleados | PeluCan{% endblock %}

{% block body %}
    {% include 'admin/components/_navbar.html.twig' %}

    <div class="min-h-screen md:pl-64">
        {% set display_name = (app.user.nombre ~ ' ' ~ app.user.apellido)|trim %}
        <header class="flex h-16 items-center justify-between border-b border-(--color-border) bg-(--color-surface) px-4 sm:px-5 md:px-8">
            <a href="{{ path('app_empleado_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-(--color-text-secondary) transition hover:text-(--color-brand)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>Volver a empleados</a>
            <span class="hidden text-sm font-semibold text-(--color-text-primary) sm:block">{{ display_name }}</span>
        </header>

        <main class="w-full px-4 py-6 sm:px-6 sm:py-8 md:px-8 md:py-9 2xl:px-12">
            <div class="mb-6 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
                <div class="flex min-w-0 items-center gap-4">
                    <span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-(--color-brand-soft) text-xl font-bold text-(--color-brand)">{{ empleado.nombre|slice(0, 1)|upper }}{{ empleado.apellido|slice(0, 1)|upper }}</span>
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-3">
                            <h1 class="text-2xl font-bold text-(--color-text-primary) sm:text-3xl">{{ empleado.nombre }} {{ empleado.apellido }}</h1>
                            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold {% if empleado.activo %}bg-(--color-success-soft) text-(--color-success){% else %}bg-(--color-danger-soft) text-(--color-danger){% endif %}"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full {% if empleado.activo %}bg-(--color-success){% else %}bg-(--color-danger){% endif %}"></span>{{ empleado.activo ? 'Activo' : 'Suspendido' }}</span>
                        </div>
                        <p class="mt-1 truncate text-sm text-(--color-text-secondary)">{{ empleado.email }}</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('app_empleado_edit', {id: empleado.id, estado: 'todos'}) }}" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-4 text-sm font-semibold text-(--color-text-primary) transition hover:bg-(--color-surface-muted)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="m14 5 5 5M4 20l4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z"/></svg>Editar</a>
                    {{ include('admin/empleado/_status_form.html.twig', {empleado: empleado, estadoFiltro: 'todos'}) }}
                </div>
            </div>

            <section aria-labelledby="empleado-contacto-title" class="mb-5 overflow-hidden rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-panel)">
                <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><h2 id="empleado-contacto-title" class="text-lg font-semibold text-(--color-text-primary)">Datos de contacto</h2><p class="mt-1 text-sm text-(--color-text-secondary)">En el equipo desde {{ empleado.createdAt ? empleado.createdAt|date('d/m/Y') : 'fecha no registrada' }}</p></div>
                <dl class="grid gap-x-6 sm:grid-cols-2 xl:grid-cols-4">
                    <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Nombre</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ empleado.nombre }}</dd></div>
                    <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Apellidos</dt><dd class="mt-1 font-medium text-(--color-text-primary)">{{ empleado.apellido }}</dd></div>
                    <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Correo electrónico</dt><dd class="mt-1 break-all font-medium text-(--color-text-primary)"><a href="mailto:{{ empleado.email }}" class="hover:text-(--color-brand)">{{ empleado.email }}</a></dd></div>
                    <div class="border-b border-(--color-border) px-5 py-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Teléfono</dt><dd class="mt-1 font-medium text-(--color-text-primary)"><a href="tel:{{ empleado.telefono }}" class="hover:text-(--color-brand)">{{ empleado.telefono }}</a></dd></div>
                    <div class="px-5 py-4 sm:col-span-2 xl:col-span-4 sm:px-6"><dt class="text-xs font-medium text-(--color-text-muted)">Dirección</dt><dd class="mt-1 whitespace-pre-line font-medium text-(--color-text-primary)">{{ empleado.direccion ?: 'Sin dirección registrada' }}</dd></div>
                </dl>
            </section>

            <section aria-labelledby="empleado-citas-title" class="overflow-hidden rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-panel)">
                <div class="flex items-center justify-between gap-3 border-b border-(--color-border) px-5 py-4 sm:px-6"><div><h2 id="empleado-citas-title" class="text-lg font-semibold text-(--color-text-primary)">Citas asignadas</h2><p class="mt-1 text-sm text-(--color-text-secondary)">Agenda e historial de trabajo.</p></div><span class="rounded-full bg-(--color-brand-soft) px-3 py-1 text-xs font-semibold text-(--color-brand)">{{ citas|length }} citas</span></div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-190 border-collapse text-left text-sm">
                        <thead class="bg-(--color-surface-muted) text-xs font-semibold text-(--color-text-secondary)"><tr><th scope="col" class="px-5 py-3">Fecha y hora</th><th scope="col" class="px-4 py-3">Mascota</th><th scope="col" class="px-4 py-3">Cliente</th><th scope="col" class="px-4 py-3">Servicios</th><th scope="col" class="px-5 py-3">Estado</th></tr></thead>
                        <tbody class="divide-y divide-(--color-border)">
                            {% for cita in citas %}
                                {% set estado = cita.estado|lower %}
                                <tr class="transition hover:bg-(--color-surface-muted)">
                                    <td class="whitespace-nowrap px-5 py-4 font-medium text-(--color-text-primary)">{{ cita.inicio ? cita.inicio|date('d/m/Y H:i') : 'Fecha pendiente' }}</td>
                                    <td class="px-4 py-4"><a href="{{ path('app_mascota_show', {id: cita.mascota.id}) }}" class="font-medium text-(--color-brand) hover:text-(--color-brand-hover)">{{ cita.mascota.nombre }}</a></td>
                                    <td class="px-4 py-4 text-(--color-text-secondary)">{{ cita.mascota.cliente ? (cita.mascota.cliente.nombre ~ ' ' ~ cita.mascota.cliente.apellido)|trim : '—' }}</td>
                                    <td class="px-4 py-4 text-(--color-text-secondary)">{% if cita.citaServicios is not empty %}{% for citaServicio in cita.citaServicios %}{% if not loop.first %}, {% endif %}{{ citaServicio.servicio.nombre }}{% endfor %}{% else %}Sin servicios detallados{% endif %}</td>
                                    <td class="px-5 py-4"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold {% if estado in ['confirmada', 'realizada'] %}bg-(--color-success-soft) text-(--color-success){% elseif estado == 'cancelada' %}bg-(--color-danger-soft) text-(--color-danger){% else %}bg-(--color-warning-soft) text-(--color-warning){% endif %}">{{ cita.estado }}</span></td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="px-5 py-12 text-center text-sm text-(--color-text-secondary)">Todavía no tiene citas asignadas.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
{% endblock %}