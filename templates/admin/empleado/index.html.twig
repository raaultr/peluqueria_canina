{% extends 'base.html.twig' %}

{% block title %}Empleados | PeluCan{% endblock %}

{% block body %}
    {% include 'admin/components/_navbar.html.twig' %}

    <div class="min-h-screen md:pl-64">
        {% set display_name = (app.user.nombre ~ ' ' ~ app.user.apellido)|trim %}
        <header class="flex h-16 items-center justify-end border-b border-(--color-border) bg-(--color-surface) px-4 sm:px-5 md:px-8">
            <div class="hidden items-center gap-3 md:flex">
                <span class="text-right"><span class="block text-sm font-semibold text-(--color-text-primary)">{{ display_name }}</span><span class="block text-xs text-(--color-text-secondary)">Administrador</span></span>
                <span class="grid h-10 w-10 place-items-center rounded-full bg-(--color-brand-soft) text-sm font-bold text-(--color-brand)" role="img" aria-label="Avatar de {{ display_name }}">{{ display_name|slice(0, 1)|upper }}</span>
            </div>
        </header>

        <main data-admin-list data-admin-item-name="empleados" data-admin-empty-all="No hay empleados en este estado." data-admin-empty-filtered="No se encontraron empleados con esos criterios." class="w-full px-4 py-6 sm:px-6 sm:py-8 md:px-8 md:py-9 2xl:px-12">
            <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                <div>
                    <h1 class="flex items-center gap-3 text-2xl font-bold text-(--color-text-primary) sm:text-3xl">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-7 w-7 text-(--color-brand)" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.5 20a5.5 5.5 0 0 1 11 0m2-9a3 3 0 1 0-1-5.8M17 14a5 5 0 0 1 3.5 6"/></svg>
                        Empleados
                    </h1>
                    <p class="mt-1 text-sm text-(--color-text-secondary)">Administra el equipo y consulta sus citas asignadas.</p>
                </div>
                <a href="{{ path('app_empleado_new', {estado: estadoFiltro}) }}" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-(--radius-control) bg-(--button-primary-background) px-4 py-2 text-sm font-semibold text-(--button-primary-text) shadow-(--shadow-panel) transition hover:bg-(--button-primary-hover)">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>Nuevo empleado
                </a>
            </div>

            <section aria-label="Resumen de empleados" class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                <article class="flex items-center gap-3 rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-panel)"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-(--radius-control) bg-(--color-brand-soft) text-(--color-brand)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.5 20a5.5 5.5 0 0 1 11 0m2-9a3 3 0 1 0-1-5.8M17 14a5 5 0 0 1 3.5 6"/></svg></span><div><p class="text-xs font-medium text-(--color-text-secondary)">Total de empleados</p><p class="mt-1 text-xl font-bold text-(--color-text-primary)">{{ estadisticas.total }}</p></div></article>
                <article class="flex items-center gap-3 rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-panel)"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-(--radius-control) bg-(--color-success-soft) text-(--color-success)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg></span><div><p class="text-xs font-medium text-(--color-text-secondary)">Activos</p><p class="mt-1 text-xl font-bold text-(--color-text-primary)">{{ estadisticas.activos }}</p></div></article>
                <article class="flex items-center gap-3 rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-panel)"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-(--radius-control) bg-(--color-danger-soft) text-(--color-danger)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6m0-6-6 6"/></svg></span><div><p class="text-xs font-medium text-(--color-text-secondary)">Suspendidos</p><p class="mt-1 text-xl font-bold text-(--color-text-primary)">{{ estadisticas.suspendidos }}</p></div></article>
                <article class="flex items-center gap-3 rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-panel)"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-(--radius-control) bg-(--color-warning-soft) text-(--color-warning)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span><div><p class="text-xs font-medium text-(--color-text-secondary)">Con citas</p><p class="mt-1 text-xl font-bold text-(--color-text-primary)">{{ estadisticas.conCitas }}</p></div></article>
            </section>

            {% for message in app.flashes('error') %}<div role="alert" class="mb-4 rounded-(--radius-control) border border-(--color-danger) bg-(--color-danger-soft) px-4 py-3 text-sm text-(--color-danger)">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('success') %}<div role="status" class="mb-4 rounded-(--radius-control) border border-(--color-success) bg-(--color-success-soft) px-4 py-3 text-sm text-(--color-success)">{{ message }}</div>{% endfor %}

            <section aria-label="Listado de empleados" class="overflow-hidden rounded-(--radius-panel) border border-(--color-border) bg-(--color-surface) shadow-(--shadow-panel)">
                <div class="flex flex-col gap-3 border-b border-(--color-border) p-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="flex min-w-0 flex-1 flex-col gap-3 sm:flex-row">
                        <label class="relative block min-w-0 flex-1"><span class="sr-only">Buscar empleados</span><svg aria-hidden="true" viewBox="0 0 24 24" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-(--color-text-muted)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4 4"/></svg><input type="search" data-admin-search placeholder="Buscar por nombre, correo o teléfono..." class="h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) pl-9 pr-3 text-sm text-(--color-text-primary) outline-none transition placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30"></label>
                        <button type="button" data-admin-filters-toggle aria-controls="empleados-filters" aria-expanded="false" class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-4 text-sm font-medium text-(--color-text-secondary) transition hover:border-(--color-brand) hover:bg-(--color-brand-soft) hover:text-(--color-brand)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z"/></svg>Filtros<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 transition-transform" data-admin-filter-chevron fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="m7 10 5 5 5-5"/></svg></button>
                    </div>
                    <p class="text-sm text-(--color-text-secondary) lg:text-right" aria-live="polite" data-admin-count>{{ empleados|length }} empleados</p>
                </div>

                <div id="empleados-filters" data-admin-filters-panel hidden class="grid gap-3 border-b border-(--color-border) bg-(--color-surface-muted) p-4 sm:grid-cols-2 xl:grid-cols-4">
                    <label class="grid gap-1.5 text-xs font-semibold text-(--color-text-secondary)">Estado<select data-admin-filter="estado" class="h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm font-normal text-(--color-text-primary) outline-none focus:border-(--color-brand)"><option value="todos" {% if estadoFiltro == 'todos' %}selected{% endif %}>Todos ({{ estadisticas.total }})</option><option value="activos" {% if estadoFiltro == 'activos' %}selected{% endif %}>Activos ({{ estadisticas.activos }})</option><option value="suspendidos" {% if estadoFiltro == 'suspendidos' %}selected{% endif %}>Suspendidos ({{ estadisticas.suspendidos }})</option></select></label>
                    <label class="grid gap-1.5 text-xs font-semibold text-(--color-text-secondary)">Empleado desde<input type="date" data-admin-date-from aria-label="Empleado desde fecha inicial" class="h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm font-normal text-(--color-text-primary) outline-none focus:border-(--color-brand)"></label>
                    <label class="grid gap-1.5 text-xs font-semibold text-(--color-text-secondary)">Hasta<input type="date" data-admin-date-to aria-label="Empleado hasta fecha final" class="h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm font-normal text-(--color-text-primary) outline-none focus:border-(--color-brand)"></label>
                    <label class="grid gap-1.5 text-xs font-semibold text-(--color-text-secondary)">Citas asignadas<select data-admin-filter="citas" class="h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm font-normal text-(--color-text-primary) outline-none focus:border-(--color-brand)"><option value="">Todas</option><option value="si">Con citas</option><option value="no">Sin citas</option></select></label>
                    <div class="flex items-end sm:col-span-2 xl:col-span-4"><button type="button" data-admin-reset class="h-10 w-full rounded-(--radius-control) px-3 text-sm font-semibold text-(--color-brand) transition hover:bg-(--color-brand-soft)">Limpiar filtros</button></div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-205 border-collapse text-left text-sm">
                        <thead class="bg-(--color-surface-muted) text-xs font-semibold text-(--color-text-secondary)"><tr><th scope="col" class="px-5 py-3">Empleado</th><th scope="col" class="px-4 py-3">Correo electrónico</th><th scope="col" class="px-4 py-3">Teléfono</th><th scope="col" class="px-4 py-3">Citas</th><th scope="col" class="px-4 py-3">Estado</th><th scope="col" class="px-4 py-3">En el equipo desde</th><th scope="col" class="px-5 py-3 text-right">Acciones</th></tr></thead>
                        <tbody class="divide-y divide-(--color-border)">
                            {% for empleado in empleados %}
                                {% set citaCount = empleado.citasComoTrabajador|length %}
                                <tr data-admin-row data-filter-estado="{{ empleado.activo ? 'activos' : 'suspendidos' }}" data-filter-citas="{{ citaCount > 0 ? 'si' : 'no' }}" data-filter-created-at="{{ empleado.createdAt ? empleado.createdAt|date('Y-m-d') : '' }}" class="transition {% if not empleado.activo %}bg-(--color-surface-muted) opacity-60{% else %}hover:bg-(--color-brand-soft)/40{% endif %}">
                                    <td class="px-5 py-4"><div class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-(--color-brand-soft) text-sm font-bold text-(--color-brand)">{{ empleado.nombre|slice(0, 1)|upper }}{{ empleado.apellido|slice(0, 1)|upper }}</span><span class="font-semibold text-(--color-text-primary)">{{ empleado.nombre }} {{ empleado.apellido }}</span></div></td>
                                    <td class="px-4 py-4 text-(--color-text-secondary)">{{ empleado.email }}</td>
                                    <td class="whitespace-nowrap px-4 py-4 text-(--color-text-secondary)">{{ empleado.telefono }}</td>
                                    <td class="px-4 py-4"><span class="inline-flex min-w-8 justify-center rounded-full px-2.5 py-1 text-xs font-semibold {{ citaCount ? 'bg-(--color-success-soft) text-(--color-success)' : 'bg-(--color-surface-muted) text-(--color-text-secondary)' }}">{{ citaCount }}</span></td>
                                    <td class="px-4 py-4"><span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold {% if empleado.activo %}bg-(--color-success-soft) text-(--color-success){% else %}bg-(--color-danger-soft) text-(--color-danger){% endif %}"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full {% if empleado.activo %}bg-(--color-success){% else %}bg-(--color-danger){% endif %}"></span>{{ empleado.activo ? 'Activo' : 'Suspendido' }}</span></td>
                                    <td class="whitespace-nowrap px-4 py-4 text-(--color-text-secondary)">{{ empleado.createdAt ? empleado.createdAt|date('d/m/Y') : '—' }}</td>
                                    <td class="px-5 py-3"><div class="flex justify-end gap-1"><a data-admin-state-link href="{{ path('app_empleado_show', {id: empleado.id}) }}" aria-label="Ver ficha de {{ empleado.nombre }} {{ empleado.apellido }}" title="Ver empleado" class="grid h-9 w-9 place-items-center rounded-(--radius-control) bg-(--color-brand-soft) text-(--color-brand) transition hover:bg-(--color-brand) hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></a><a data-admin-state-link href="{{ path('app_empleado_edit', {id: empleado.id, estado: estadoFiltro}) }}" aria-label="Editar a {{ empleado.nombre }} {{ empleado.apellido }}" title="Editar empleado" class="grid h-9 w-9 place-items-center rounded-(--radius-control) bg-(--color-warning-soft) text-(--color-warning) transition hover:bg-(--color-warning) hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="m14 5 5 5M4 20l4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z"/></svg></a>{{ include('admin/empleado/_status_form.html.twig', {empleado: empleado, estadoFiltro: estadoFiltro}) }}</div></td>
                                </tr>
                            {% else %}
                                <tr data-admin-empty><td colspan="7" class="px-5 py-12 text-center text-sm text-(--color-text-secondary)">No hay empleados en este estado.</td></tr>
                            {% endfor %}
                            {% if empleados is not empty %}<tr data-admin-empty hidden><td colspan="7" class="px-5 py-12 text-center text-sm text-(--color-text-secondary)">No se encontraron empleados con esos criterios.</td></tr>{% endif %}
                        </tbody>
                    </table>
                </div>
                <footer class="flex flex-col gap-3 border-t border-(--color-border) px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5"><p class="text-sm text-(--color-text-secondary)" aria-live="polite" data-admin-pagination-summary>Mostrando {{ empleados|length }} empleados</p><div class="flex flex-wrap items-center justify-between gap-3 sm:justify-end"><label class="flex items-center gap-2 text-sm text-(--color-text-secondary)">Filas<select data-admin-page-size aria-label="Filas por página" class="h-9 rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-2 text-sm text-(--color-text-primary)"><option value="10" selected>10</option><option value="25">25</option><option value="50">50</option></select>por página</label><nav aria-label="Paginación de empleados" class="flex items-center gap-2"><button type="button" data-admin-previous aria-label="Página anterior" class="grid h-9 w-9 place-items-center rounded-(--radius-control) border border-(--color-border) text-(--color-text-secondary) hover:bg-(--color-brand-soft) disabled:opacity-40"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button><span class="min-w-16 text-center text-sm font-medium text-(--color-text-primary)" aria-live="polite" data-admin-page-indicator>1 / 1</span><button type="button" data-admin-next aria-label="Página siguiente" class="grid h-9 w-9 place-items-center rounded-(--radius-control) border border-(--color-border) text-(--color-text-secondary) hover:bg-(--color-brand-soft) disabled:opacity-40"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button></nav></div></footer>
            </section>
        </main>
    </div>
    {% if modal %}{{ include('admin/components/_form_modal.html.twig', {modalTitle: modal.title, modalDescription: modal.description, modalCloseUrl: modal.closeUrl, modalFormTemplate: modal.formTemplate, modalSubmitLabel: modal.submitLabel, form: modal.form}) }}{% endif %}
{% endblock %}