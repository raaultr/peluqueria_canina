{{ form_start(form, {attr: {class: 'space-y-5'}}) }}
    <div class="grid gap-4 sm:grid-cols-2">
        {{ form_row(form.nombre, {row_attr: {class: 'space-y-1.5 sm:col-span-2'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}
        {{ form_row(form.duracionMins, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'h-10 w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}
        <div class="flex items-center gap-3 pt-6">{{ form_widget(form.activo, {attr: {class: 'h-4 w-4 rounded border-(--color-border) accent-(--color-brand)'}}) }}{{ form_label(form.activo, null, {label_attr: {class: 'text-sm font-medium text-(--color-text-primary)'}}) }}</div>
        <div class="sm:col-span-2">{{ form_row(form.descripcion, {row_attr: {class: 'space-y-1.5'}, label_attr: {class: 'block text-sm font-medium text-(--color-text-primary)'}, attr: {class: 'w-full rounded-(--radius-control) border border-(--color-border) bg-(--color-surface) px-3 py-2 text-sm text-(--color-text-primary) outline-none placeholder:text-(--color-text-muted) focus:border-(--color-brand) focus:ring-2 focus:ring-(--focus-ring)/30'}}) }}</div>
    </div>
    <div class="flex flex-col-reverse gap-3 border-t border-(--color-border) pt-5 sm:flex-row sm:justify-end">
        <a href="{{ path('app_servicio_index') }}" class="inline-flex min-h-10 items-center justify-center rounded-(--radius-control) border border-(--color-border) px-4 text-sm font-medium text-(--color-text-secondary) transition hover:bg-(--color-surface-muted)">Cancelar</a>
        <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-(--radius-control) bg-(--button-primary-background) px-5 text-sm font-semibold text-(--button-primary-text) transition hover:bg-(--button-primary-hover)">{{ modalSubmitLabel }}</button>
    </div>
{{ form_end(form) }}