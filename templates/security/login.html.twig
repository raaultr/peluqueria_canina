{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión | PeluCan{% endblock %}

{% block body %}
    <main class="auth-page">
        <section class="auth-shell" aria-label="Iniciar sesión">
            <aside class="auth-brand-panel">
                <a class="auth-brand" href="{{ path('app_login') }}" aria-label="PeluCan, inicio de sesión">
                    <svg class="auth-brand-mark" viewBox="0 0 48 48" aria-hidden="true">
                        <path fill="currentColor" d="M24 23c-5.1 0-11.4 6.1-11.4 11.7 0 4.2 3.2 6.3 7.3 4.4 2.6-1.2 5.6-1.2 8.2 0 4.1 1.9 7.3-.2 7.3-4.4C35.4 29.1 29.1 23 24 23Z"/>
                        <ellipse fill="currentColor" cx="10.2" cy="19.3" rx="4.3" ry="6.2" transform="rotate(-24 10.2 19.3)"/>
                        <ellipse fill="currentColor" cx="20" cy="10.9" rx="4.2" ry="6.1" transform="rotate(-8 20 10.9)"/>
                        <ellipse fill="currentColor" cx="30.5" cy="10.9" rx="4.2" ry="6.1" transform="rotate(8 30.5 10.9)"/>
                        <ellipse fill="currentColor" cx="38" cy="19.5" rx="4.3" ry="6.2" transform="rotate(24 38 19.5)"/>
                    </svg>
                    <span><span class="auth-brand-name">PeluCan</span><span class="auth-brand-caption">Peluquería Canina</span></span>
                </a>
                <div class="auth-brand-copy">
                    <h1>Tu mascota<br>en las <span>mejores manos</span></h1>
                    <p>Cuidamos, mimamos y embellecemos a tu compañero de vida.</p>
                </div>
                <div class="auth-pet-backdrop" aria-hidden="true"></div>
                <img class="auth-pet-image" src="{{ asset('img/golden-login.webp') }}" alt="Perro disfrutando al aire libre">
            </aside>

            <div class="auth-form-panel">
                {% if app.user %}
                    <p class="auth-error">Ya has iniciado sesión como {{ app.user.userIdentifier }}. <a href="{{ logout_path() }}">Cerrar sesión</a></p>
                {% endif %}

                <p class="auth-eyebrow">Bienvenido de nuevo</p>
                <h2 class="auth-title">Iniciar sesión</h2>
                <p class="auth-subtitle">Accede a tu cuenta para gestionar tus mascotas y reservas.</p>

                {% if error %}
                    <div class="auth-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" class="auth-form">
                    <div class="auth-field">
                        <label class="auth-sr-only" for="username">Correo electrónico</label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                            </span>
                            <input type="email" value="{{ last_username }}" name="_username" id="username" class="auth-input" placeholder="Correo electrónico" autocomplete="email" required autofocus>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="auth-sr-only" for="password">Contraseña</label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/></svg>
                            </span>
                            <input type="password" name="_password" id="password" class="auth-input" placeholder="Contraseña" autocomplete="current-password" required>
                            <button class="auth-password-toggle" type="button" data-password-toggle aria-controls="password" aria-label="Mostrar contraseña" aria-pressed="false">
                                <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                                <svg class="eye-off-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 6.2A10.9 10.9 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.1 3.6M6.2 6.8C3.5 8.5 2 12 2 12s3.6 6 10 6c1.2 0 2.3-.2 3.3-.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                            </button>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button class="auth-submit" type="submit">
                        Iniciar sesión
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                </form>

                <p class="auth-footer">¿No tienes una cuenta? <a href="{{ path('app_register') }}">Regístrate</a></p>
            </div>
        </section>
    </main>
{% endblock %}
