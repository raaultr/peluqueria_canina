{% extends 'base.html.twig' %}

{% block title %}PeluCan | Peluquería canina profesional{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="public-home">
    {{ include('publico/components/_navbar.html.twig') }}

    <main>
        <section class="home-hero" id="inicio" aria-labelledby="home-hero-title">
            <div class="home-shell home-hero-grid">
                <div class="home-hero-copy">
                    <p class="home-eyebrow">{{ include('publico/components/_paw.html.twig', {class: 'home-eyebrow-paw'}) }}Peluquería Canina Profesional</p>
                    <h1 id="home-hero-title">Porque ellos también<br class="home-desktop-break"> merecen <span class="home-highlight">lo mejor<svg aria-hidden="true" viewBox="0 0 190 20" preserveAspectRatio="none"><path d="M5 15C49 2 128 1 184 12"/></svg></span></h1>
                    <p class="home-hero-description">En PeluCan cuidamos, mimamos y embellecemos a tu mascota con el cariño que se merece.</p>
                    <div class="home-hero-actions">
                        <a class="home-button home-button--primary" href="{{ path('app_login') }}">Agendar cita <span aria-hidden="true">→</span></a>
                        <a class="home-button home-button--outline" href="#servicios">Conoce nuestros servicios</a>
                    </div>
                </div>
                <div class="home-hero-art" aria-label="Golden retriever listo para su sesión de peluquería">
                    <div class="home-hero-blob" aria-hidden="true"></div>
                    {{ include('publico/components/_paw.html.twig', {class: 'home-paw home-paw--hero'}) }}
                    <img class="home-hero-dog" src="{{ asset('img/golden-sinfondo-transparent.png') }}" alt="Golden retriever sonriente" fetchpriority="high" draggable="true">
                    <div class="home-hero-note"><span class="home-heart-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg></span><span>Mascotas felices,<br>dueños tranquilos</span></div>
                </div>
            </div>
        </section>

        <section class="home-metrics" id="resultados" aria-label="PeluCan en cifras">
            <div class="home-shell home-metrics-grid">
                <article class="home-metric"><span class="home-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 10h16l-1.5 10h-13L4 10Zm3 0a5 5 0 0 1 10 0M3 14h18"/></svg></span><strong>+12.000</strong><span>Baños y cortes realizados</span></article>
                <article class="home-metric"><span class="home-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></span><strong>99,4%</strong><span>Familias satisfechas</span></article>
                <article class="home-metric"><span class="home-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19h16M6 16V9h12v7M9 9V5h6v4M9 12h.01M12 12h.01M15 12h.01"/></svg></span><strong>8</strong><span>Estilistas con máster canino</span></article>
                <article class="home-metric"><span class="home-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 10v4m4-7v10m8-10v10m4-7v4M2 12h20"/></svg></span><strong>0% estrés</strong><span>Sin jaulas ni prisas</span></article>
            </div>
        </section>

        <section class="home-catalog home-section" id="servicios" aria-labelledby="home-services-title">
            <div class="home-shell">
                <div class="home-catalog-heading">
                    <div class="home-section-intro">
                        <p class="home-kicker">Catálogo de estética y salud</p>
                        <h2 id="home-services-title">Servicios diseñados para su bienestar y confort</h2>
                        <p>Tarifas transparentes según la complexión y el manto de tu compañero. Elige su tamaño para consultar los precios.</p>
                    </div>
                    <div class="home-size-tabs" role="group" aria-label="Tamaño del perro">
                        <button class="home-size-tab is-active" type="button" data-dog-size-control data-size="small" aria-pressed="true">Pequeño <span>(&lt;10 kg)</span></button>
                        <button class="home-size-tab" type="button" data-dog-size-control data-size="medium" aria-pressed="false">Mediano <span>(10-25 kg)</span></button>
                        <button class="home-size-tab" type="button" data-dog-size-control data-size="large" aria-pressed="false">Grande <span>(&gt;25 kg)</span></button>
                    </div>
                </div>
                <div class="home-price-grid">
                    <article class="home-price-card">
                        <div class="home-price-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 10h16l-1.5 10h-13L4 10Zm3 0a5 5 0 0 1 10 0M3 14h18"/></svg></div>
                        <h3>Baño e hidratación</h3>
                        <p>Doble enjabonado dermocosmético, mascarilla acondicionadora y cepillado profundo.</p>
                        <div class="home-price-meta"><span>50-60 min</span><div><small>desde</small><strong data-service-price data-small="28 €" data-medium="36 €" data-large="46 €">28 €</strong></div></div>
                        <ul><li>Champú según tipo de manto</li><li>Limpieza ótica y ocular</li><li>Corte y limado de uñas</li><li>Secado térmico controlado</li></ul>
                        <a href="{{ path('app_login') }}">Seleccionar servicio <span aria-hidden="true">→</span></a>
                    </article>
                    <article class="home-price-card is-popular">
                        <span class="home-popular-label">Más popular</span>
                        <div class="home-price-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="m8 8 8 8m0-8-8 8"/></svg></div>
                        <h3>Corte tijera y raza</h3>
                        <p>Modelado artístico a tijera o estilismo higiénico, fiel al estándar de cada raza.</p>
                        <div class="home-price-meta"><span>75-90 min</span><div><small>desde</small><strong data-service-price data-small="42 €" data-medium="52 €" data-large="65 €">42 €</strong></div></div>
                        <ul><li>Incluye sesión completa de baño</li><li>Técnica a tijera especializada</li><li>Repaso de zonas higiénicas</li><li>Perfume hipoalergénico</li></ul>
                        <a href="{{ path('app_login') }}">Reservar este servicio <span aria-hidden="true">→</span></a>
                    </article>
                    <article class="home-price-card">
                        <div class="home-price-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20c4-1 6-5 8-10l2-5 3 2-2 5c-2 5-2 9-7 9H4Z"/><path d="m13 8 4 3M5 17l3 3"/></svg></div>
                        <h3>Deslanado y muda</h3>
                        <p>Eliminación minuciosa del subpelo muerto para mantos dobles y épocas de muda.</p>
                        <div class="home-price-meta"><span>70-85 min</span><div><small>desde</small><strong data-service-price data-small="38 €" data-medium="48 €" data-large="60 €">38 €</strong></div></div>
                        <ul><li>Carda y deslanador ergonómico</li><li>Expulsor de aire suave</li><li>Ayuda a prevenir nudos</li><li>Reduce el pelo suelto en casa</li></ul>
                        <a href="{{ path('app_login') }}">Seleccionar servicio <span aria-hidden="true">→</span></a>
                    </article>
                    <article class="home-price-card">
                        <div class="home-price-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1"/><circle cx="12" cy="12" r="5"/></svg></div>
                        <h3>Spa y ozonoterapia</h3>
                        <p>Hidroterapia con microburbujas y masaje balsámico para pieles sensibles o maduras.</p>
                        <div class="home-price-meta"><span>60-70 min</span><div><small>desde</small><strong data-service-price data-small="49 €" data-medium="59 €" data-large="72 €">49 €</strong></div></div>
                        <ul><li>Agua purificada ozonizada</li><li>Cuidado de la piel</li><li>Masaje de relajación</li><li>Atención para pieles sensibles</li></ul>
                        <a href="{{ path('app_login') }}">Seleccionar servicio <span aria-hidden="true">→</span></a>
                    </article>
                </div>
            </div>
        </section>

        <section class="home-method home-section" id="nosotros" aria-labelledby="home-method-title">
            <div class="home-shell">
                <div class="home-centered-intro">
                    <p class="home-kicker">Protocolo clínico y cariñoso</p>
                    <h2 id="home-method-title">El Método PeluCan en 4 pasos</h2>
                    <p>Una experiencia adaptada al ritmo, temperamento y salud de cada perro.</p>
                </div>
                <div class="home-steps-grid">
                    <article class="home-step"><span class="home-step-number">01</span><span class="home-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8m-8 4h5"/></svg></span><h3>Evaluación de manto y piel</h3><p>Revisamos su piel, el estado del pelo y posibles nudos para elegir los productos adecuados.</p></article>
                    <article class="home-step"><span class="home-step-number">02</span><span class="home-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3s6 7 6 12a6 6 0 0 1-12 0c0-5 6-12 6-12Z"/><path d="M9 16a3 3 0 0 0 3 3"/></svg></span><h3>Baño relajante termal</h3><p>Agua a temperatura confortable, masajes suaves y productos delicados para su piel.</p></article>
                    <article class="home-step"><span class="home-step-number">03</span><span class="home-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v8m0 0 4-4m-4 4L8 7m-3 8a7 7 0 0 0 14 0"/></svg></span><h3>Secado silencioso</h3><p>Secado gradual a temperatura controlada para que esté cómodo durante todo el proceso.</p></article>
                    <article class="home-step"><span class="home-step-number">04</span><span class="home-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m14 4 6 6M4 20l4.5-1L19 8.5 15.5 5 5 15.5 4 20Z"/><path d="m13 7 4 4"/></svg></span><h3>Corte y estilismo</h3><p>Terminamos con un corte cuidado, respetando su raza, su manto y su personalidad.</p></article>
                </div>
                <div class="home-facility-banner"><span class="home-facility-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></span><div><h3>Transparencia total: ven a ver a tu peludo</h3><p>Nuestras áreas de trabajo cuentan con cristaleras para que puedas ver cómo cuidamos de tu compañero.</p></div><a href="{{ path('app_login') }}">Descubrir PeluCan <span aria-hidden="true">→</span></a></div>
            </div>
        </section>

        <section class="home-reviews home-section" aria-labelledby="home-reviews-title">
            <div class="home-shell">
                <div class="home-reviews-heading"><div><p class="home-kicker">Experiencias felices</p><h2 id="home-reviews-title">Lo que opinan sus humanos</h2></div><span class="home-rating"><strong>4,9</strong><span aria-label="5 de 5 estrellas">★★★★★</span><small>850+ valoraciones</small></span></div>
                <div class="home-reviews-grid">
                    <article class="home-review"><div class="home-stars" aria-label="5 de 5 estrellas">★★★★★</div><blockquote>“Rocky tiene pánico a las tijeras por una mala experiencia. En PeluCan se tomaron el tiempo necesario para tranquilizarlo. Salió radiante y con un pelazo sedoso.”</blockquote><div class="home-review-author"><span>EM</span><div><strong>Elena Martín</strong><small>Tutora de Rocky · Golden Retriever</small></div></div></article>
                    <article class="home-review"><div class="home-stars" aria-label="5 de 5 estrellas">★★★★★</div><blockquote>“El corte asiático que le hacen a Coco es una obra de arte. Nunca lo había visto con el pelo tan suave y sin nudos. El trato es estupendo.”</blockquote><div class="home-review-author"><span>CS</span><div><strong>Carlos Sainz</strong><small>Tutor de Coco · Caniche Toy</small></div></div></article>
                    <article class="home-review"><div class="home-stars" aria-label="5 de 5 estrellas">★★★★★</div><blockquote>“El deslanado de Luna en primavera es sagrado. La dejaron preciosa y sin tirones. Llegar a casa sin bolas de pelo por el suelo no tiene precio.”</blockquote><div class="home-review-author"><span>SD</span><div><strong>Silvia Domínguez</strong><small>Tutora de Luna · Border Collie</small></div></div></article>
                </div>
            </div>
        </section>

        <section class="home-cta-section" aria-labelledby="home-cta-title">
            <div class="home-shell"><div class="home-cta">
                <span class="home-cta-kicker">Cuidado sin estrés</span>
                <h2 id="home-cta-title">¿Listo para consentir a tu compañero como se merece?</h2>
                <p>Accede a tu cuenta para solicitar una cita. Escoge el día, la hora y el servicio que mejor se adapte a tu mascota.</p>
                <div class="home-cta-actions"><a class="home-button home-button--light" href="{{ path('app_login') }}">Pedir cita ahora <span aria-hidden="true">→</span></a><a class="home-button home-button--glass" href="tel:+34912345678">+34 912 345 678</a></div>
                <small>Sin pagos por adelantado. Pagas al recoger a tu mascota.</small>
            </div></div>
        </section>
    </main>

    <footer class="home-footer" id="contacto">
        <div class="home-shell home-footer-grid">
            <div class="home-footer-brand"><a class="home-brand" href="{{ path('app_publico_home') }}">{{ include('publico/components/_paw.html.twig', {class: 'home-brand-mark'}) }}<span>PeluCan</span></a><p>Cuidado experto, estética canina y bienestar integral con el cariño que tu compañero merece.</p><span class="home-quality"><span aria-hidden="true">✓</span> Compromiso con su bienestar</span></div>
            <div><h3>Servicios</h3><ul><li><a href="#servicios">Baño dermatológico y secado</a></li><li><a href="#servicios">Corte de raza y estilismo</a></li><li><a href="#servicios">Higiene de oídos</a></li><li><a href="#servicios">Corte y limado de uñas</a></li><li><a href="#servicios">Tratamientos de hidratación</a></li></ul></div>
            <div><h3>Horario y atención</h3><ul class="home-footer-hours"><li>Lunes a viernes: 09:30-20:00</li><li>Sábados: 10:00-14:30</li><li>Domingos: cerrado</li></ul><a class="home-footer-phone" href="tel:+34912345678">+34 912 345 678</a></div>
            <div><h3>Ubicación</h3><p>Calle Canina 42<br>28001 Madrid, España</p><h4>Comunidad</h4><div class="home-social-links"><a href="mailto:hola@pelucan.test" aria-label="Enviar correo a PeluCan">@</a><a href="tel:+34912345678" aria-label="Llamar a PeluCan">☎</a></div></div>
        </div>
        <div class="home-shell home-footer-bottom"><span>© 2026 PeluCan. Todos los derechos reservados.</span><div><a href="#contacto">Aviso legal</a><a href="#contacto">Privacidad</a><a href="#contacto">Términos</a></div></div>
    </footer>
</div>
<script>
    document.querySelectorAll('[data-dog-size-control]').forEach((button) => {
        button.addEventListener('click', () => {
            const size = button.dataset.size;

            document.querySelectorAll('[data-dog-size-control]').forEach((tab) => {
                const isSelected = tab === button;
                tab.classList.toggle('is-active', isSelected);
                tab.setAttribute('aria-pressed', String(isSelected));
            });

            document.querySelectorAll('[data-service-price]').forEach((price) => {
                price.textContent = price.dataset[size];
            });
        });
    });
</script>
{% endblock %}
