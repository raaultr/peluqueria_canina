{% extends 'base.html.twig' %}

{% block title %}Crear cuenta | PeluCan{% endblock %}

{% block body %}
    <main class="auth-page">
        <section class="auth-shell" aria-label="Crear cuenta">
            <aside class="auth-brand-panel">
                <a class="auth-brand" href="{{ path('app_register') }}" aria-label="PeluCan, crear cuenta">
                    <svg class="auth-brand-mark" viewBox="0 0 48 48" aria-hidden="true">
                        <path fill="currentColor" d="M24 23c-5.1 0-11.4 6.1-11.4 11.7 0 4.2 3.2 6.3 7.3 4.4 2.6-1.2 5.6-1.2 8.2 0 4.1 1.9 7.3-.2 7.3-4.4C35.4 29.1 29.1 23 24 23Z"/>
                        <ellipse fill="currentColor" cx="10.2" cy="19.3" rx="4.3" ry="6.2" transform="rotate(-24 10.2 19.3)"/>
                        <ellipse fill="currentColor" cx="20" cy="10.9" rx="4.2" ry="6.1" transform="rotate(-8 20 10.9)"/>
                        <ellipse fill="currentColor" cx="30.5" cy="10.9" rx="4.2" ry="6.1" transform="rotate(8 30.5 10.9)"/>
                        <ellipse fill="currentColor" cx="38" cy="19.5" rx="4.3" ry="6.2" transform="rotate(24 38 19.5)"/>
                    </svg>
                    <span><span class="auth-brand-name">PeluCan</span><span class="auth-brand-caption">Peluquería Canina</span></span>
                </a>
                <div class="auth-brand-copy">
                    <h1>¡Únete a<br><span>nuestra familia!</span></h1>
                    <p>Regístrate y comienza a disfrutar de todos los beneficios.</p>
                </div>
                <div class="auth-pet-backdrop" aria-hidden="true"></div>
                <img class="auth-pet-image" src="{{ asset('img/golden-login.webp') }}" alt="Perro disfrutando al aire libre">
            </aside>

            <div class="auth-form-panel">
                <p class="auth-eyebrow">PeluCan</p>
                <h2 class="auth-title">Crear cuenta</h2>
                <p class="auth-subtitle">Completa tus datos para empezar.</p>

                {{ form_errors(registrationForm) }}
                {{ form_start(registrationForm, {attr: {class: 'auth-form auth-form--register'}}) }}
                    <div class="auth-field-grid">
                        <div class="auth-field">
                            {{ form_label(registrationForm.nombre, null, {label_attr: {class: 'auth-sr-only'}}) }}
                            <div class="auth-input-wrap">
                                <span class="auth-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
                                {{ form_widget(registrationForm.nombre, {attr: {class: 'auth-input', placeholder: 'Nombre', autocomplete: 'given-name'}}) }}
                            </div>
                            <div class="auth-field-error">{{ form_errors(registrationForm.nombre) }}</div>
                        </div>
                        <div class="auth-field">
                            {{ form_label(registrationForm.apellido, null, {label_attr: {class: 'auth-sr-only'}}) }}
                            <div class="auth-input-wrap">
                                <span class="auth-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
                                {{ form_widget(registrationForm.apellido, {attr: {class: 'auth-input', placeholder: 'Apellido', autocomplete: 'family-name'}}) }}
                            </div>
                            <div class="auth-field-error">{{ form_errors(registrationForm.apellido) }}</div>
                        </div>
                    </div>

                    <div class="auth-field">
                        {{ form_label(registrationForm.email, null, {label_attr: {class: 'auth-sr-only'}}) }}
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></span>
                            {{ form_widget(registrationForm.email, {attr: {class: 'auth-input', placeholder: 'Correo electrónico', autocomplete: 'email'}}) }}
                        </div>
                        <div class="auth-field-error">{{ form_errors(registrationForm.email) }}</div>
                    </div>

                    <div class="auth-field">
                        {{ form_label(registrationForm.telefono, null, {label_attr: {class: 'auth-sr-only'}}) }}
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 3a14 14 0 0 1-7-7l3-2-3-6Z"/></svg></span>
                            {{ form_widget(registrationForm.telefono, {attr: {class: 'auth-input', placeholder: 'Teléfono', autocomplete: 'tel'}}) }}
                        </div>
                        <div class="auth-field-error">{{ form_errors(registrationForm.telefono) }}</div>
                    </div>

                    {% for passwordField in [registrationForm.plainPassword.first, registrationForm.plainPassword.second] %}
                        <div class="auth-field">
                            {{ form_label(passwordField, null, {label_attr: {class: 'auth-sr-only'}}) }}
                            <div class="auth-input-wrap">
                                {{ form_widget(passwordField, {attr: {class: 'auth-input', placeholder: passwordField.vars.label, autocomplete: 'new-password'}}) }}
                                <button class="auth-password-toggle" type="button" data-password-toggle aria-controls="{{ passwordField.vars.id }}" aria-label="Mostrar contraseña" aria-pressed="false">
                                    <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                                    <svg class="eye-off-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 6.2A10.9 10.9 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.1 3.6M6.2 6.8C3.5 8.5 2 12 2 12s3.6 6 10 6c1.2 0 2.3-.2 3.3-.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                                </button>
                            </div>
                            <div class="auth-field-error">{{ form_errors(passwordField) }}</div>
                        </div>
                    {% endfor %}

                    <div class="auth-terms">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms, 'Acepto los términos y condiciones') }}
                    </div>
                    <div class="auth-field-error">{{ form_errors(registrationForm.agreeTerms) }}</div>

                    <button type="submit" class="auth-submit">
                        Registrarme
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                {{ form_end(registrationForm) }}

                <p class="auth-footer">¿Ya tienes una cuenta? <a href="{{ path('app_login') }}">Inicia sesión</a></p>
            </div>
        </section>
    </main>
{% endblock %}
